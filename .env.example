# Backend (docker-compose читает этот файл как .env)
MAX_UPLOAD_MB=8            # максимальный размер файла
MAX_CONCURRENT_JOBS=1      # параллельные генерации (каждая ~0.7 ГБ RAM, ~20 с CPU)
JOB_TIMEOUT_SEC=90         # таймаут одного подпроцесса обработки
RATE_LIMIT_PER_MIN=4       # запросов /api/draw в минуту с одного IP
TRUST_PROXY=1              # за nginx: IP клиента из X-Forwarded-For
ENABLE_DOCS=0              # 1 = открыть /api/docs (только для отладки)
