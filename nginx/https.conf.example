# HTTPS: замените default.conf этим файлом (после выпуска сертификата) и подставьте домен.
# Сертификаты Let's Encrypt монтируются в контейнер web: /etc/letsencrypt (см. docker-compose.yml, README).
limit_req_zone $binary_remote_addr zone=draw:10m rate=6r/m;

server {
    listen 80;
    server_name example.com;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name example.com;
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # остальное — как в nginx/default.conf (root, gzip, location /api/draw, /api/, /assets/, /)
    root /usr/share/nginx/html;
    client_max_body_size 10m;
    server_tokens off;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;

    location /api/draw {
        limit_req zone=draw burst=3 nodelay;
        limit_req_status 429;
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
}
