FROM python:3.9-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 LIE_OFFLINE=1
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install -r backend/requirements.txt
COPY backend/app.py backend/pipeline.py backend/
COPY tools/make_strokes.py tools/make_strokes_v4.py tools/engine_e.py tools/
# модели ВНУТРИ образа: во время запроса ничего не скачивается (LIE_OFFLINE=1)
COPY tools/models/face_landmarker.task tools/models/selfie_segmenter.tflite tools/models/informative_anime_512.onnx tools/models/
RUN test -f tools/models/face_landmarker.task && test -f tools/models/selfie_segmenter.tflite && test -f tools/models/informative_anime_512.onnx
RUN useradd -m app && chown -R app /app
USER app
WORKDIR /app/backend
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD curl -fs http://127.0.0.1:8000/api/health || exit 1
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
